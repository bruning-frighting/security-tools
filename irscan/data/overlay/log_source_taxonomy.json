{
  "_meta": {
    "purpose": "Classify ATT&CK v20 log-source names into evidence categories so the registry builder can derive a testability class deterministically.",
    "derivation": "Key set enumerated mechanically from the pinned bundle: every distinct x_mitre_log_sources[].name on x-mitre-data-component objects and every x_mitre_log_source_references[].name on x-mitre-analytic objects (399 distinct names, 146 distinct prefixes in enterprise-attack-20.0.json).",
    "matching": "Name is lowercased and whitespace-trimmed. 'exact' is tried first (for legacy ATT&CK data-source names that carry no prefix), then the substring before the first ':' is looked up in 'prefixes'. Unmatched names are reported by the builder as unclassified_log_sources and must be triaged, never silently dropped.",
    "categories": {
      "win_telemetry": "Host-local Windows log/event telemetry. Requires the log to have been enabled and retained.",
      "linux_telemetry": "Host-local Linux log/audit telemetry. Requires the subsystem to have been enabled and retained.",
      "artifact": "Persistent host state that survives execution and is readable by a current-state scan.",
      "generic_telemetry": "Legacy unprefixed ATT&CK data source describing execution/session activity, i.e. telemetry rather than durable state.",
      "edr": "Requires a third-party EDR product's telemetry; not present by default on a stock host.",
      "integrity_baseline": "Requires a pre-existing integrity baseline (FIM, firmware attestation, asset inventory) to be meaningful.",
      "network": "Requires network sensor visibility (pcap, flow, proxy, IDS, DNS logs).",
      "cloud_offhost": "Evidence lives in a cloud/SaaS/identity control plane, not on the host.",
      "other_platform": "Host-local but for a platform outside this tool's Windows/Linux scope (macOS, iOS, Android, ESXi, network devices, OT).",
      "external": "Evidence is outside the victim estate entirely (malware repositories, internet-wide scan data)."
    }
  },

